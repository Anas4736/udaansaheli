# UdaanSaheli Server Environment Variables
PORT=5000
NODE_ENV=development
# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/udaansaheli?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/udaansaheli
# Allowed CORS Origins (comma separated or specific URL)
CORS_ORIGIN=http://localhost:5173
